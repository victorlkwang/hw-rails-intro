
<p style="color: green"><%= notice %></p>

<h1>Movies</h1>

<%= form_tag movies_path, method: :get,
             id: 'ratings_form', local: true do %>

  <p>Include:</p>

  <% @all_ratings.each do |rating| %>
    <div class="form-check form-check-inline">
      <%= check_box_tag "ratings[#{rating}]", "1",
          @ratings_to_show.include?(rating),
          class: 'form-check-input' %>

      <%= label_tag "ratings[#{rating}]", rating,
          class: 'form-check-label' %>
    </div>
  <% end %>

  <div>
    <label class="form-label me-2" for="sort_by">
      Sort by:
    </label>

    <%= select_tag :sort_by,
        options_for_select(
          [["Title", "title"],
           ["Release Date", "release_date"]],
          @sort_by
        ),
        id: "sort_by",
        class: "form-select d-inline w-auto" %>
  </div>

  <%= submit_tag 'Refresh',
      id: 'ratings_submit',
      class: 'btn btn-primary' %>

<% end %>

<table id="movies" class="table">
  <thead>
    <tr>
      <th>
        <%= link_to "Title",
            movies_path(
              sort_by: "title",
              ratings: @ratings_to_show.index_with("1")
            ) %>
      </th>

      <th>Rating</th>

      <th>
        <%= link_to "Release Date",
            movies_path(
              sort_by: "release_date",
              ratings: @ratings_to_show.index_with("1")
            ) %>
      </th>

      <th>Details</th>
    </tr>
  </thead>

  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td><%= movie.title %></td>
        <td><%= movie.rating %></td>
        <td><%= movie.release_date&.to_date %></td>
        <td>
          <%= link_to "Show this movie",
              movie_path(movie) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "New movie", new_movie_path %>
